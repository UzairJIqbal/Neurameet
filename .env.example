# Copy to .env.local and fill in. Never commit real values.

# App URL (used for invite and meeting links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stream Video
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# Supabase (Postgres + pgvector)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (free tiers): Gemini primary, Groq fallback + Whisper
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Email notifications (optional, Resend free tier)
RESEND_API_KEY=
# Defaults to onboarding@resend.dev when unset
RESEND_FROM=

# GitHub App (Step W5)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_APP_SLUG=

CRON_SECRET=
RESEND_WORKSPACE_FROM=